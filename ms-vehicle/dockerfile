# --- Build ---
FROM maven:3.9-eclipse-temurin-17 AS builder
WORKDIR /build
COPY pom.xml .
COPY common ./common
COPY ms-vehicle ./ms-vehicle
RUN mvn clean package -DskipTests -pl ms-vehicle -am

# --- Run ---
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
COPY --from=builder /build/ms-vehicle/target/*.jar app.jar
EXPOSE 8082
ENTRYPOINT ["java", "-jar", "app.jar"]