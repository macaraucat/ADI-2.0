# --- Build ---
FROM maven:3.9-eclipse-temurin-17 AS builder
WORKDIR /build
COPY pom.xml .
COPY common ./common
COPY ms-login ./ms-login
RUN mvn clean package -DskipTests -pl ms-login -am

# --- Run ---
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
COPY --from=builder /build/ms-login/target/*.jar app.jar
EXPOSE 8081
ENTRYPOINT ["java", "-jar", "app.jar"]