# --- Build ---
FROM maven:3.9-eclipse-temurin-17 AS builder
WORKDIR /build
COPY pom.xml .
COPY common ./common
COPY ms-notification ./ms-notification
RUN mvn clean package -DskipTests -pl ms-notification -am

# --- Run ---
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
COPY --from=builder /build/ms-notification/target/*.jar app.jar
EXPOSE 8086
ENTRYPOINT ["java", "-jar", "app.jar"]