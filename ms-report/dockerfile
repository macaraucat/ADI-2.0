# --- Build ---
FROM maven:3.9-eclipse-temurin-17 AS builder
WORKDIR /build
COPY pom.xml .
COPY common ./common
COPY ms-report ./ms-report
RUN mvn clean package -DskipTests -pl ms-report -am

# --- Run ---
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app
COPY --from=builder /build/ms-report/target/*.jar app.jar
EXPOSE 8085
ENTRYPOINT ["java", "-jar", "app.jar"]